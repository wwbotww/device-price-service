APP_ENV=development
LOG_LEVEL=INFO
LIVE_CRAWL_ENABLED=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=device_price
MYSQL_USER=device_price
MYSQL_PASSWORD=device-price-local

CRAWLER_USER_AGENT=CompanyDevicePriceBot/1.0 (+contact@example.com)
HTTP_CONCURRENCY_PER_DOMAIN=2
HTTP_MIN_DELAY_SECONDS=0.8
HTTP_MAX_DELAY_SECONDS=2.0
HTTP_CONNECT_TIMEOUT_SECONDS=10.0
HTTP_READ_TIMEOUT_SECONDS=30.0
HTTP_MAX_REDIRECTS=5
HTTP_MAX_RESPONSE_BYTES=10485760
BROWSER_TIMEOUT_MS=30000
PRICE_CHANGE_CONFIRM_THRESHOLD=0.30
RAW_STORAGE_PATH=var/raw
RAW_RETENTION_DAYS=30
FULL_CRAWL_INTERVAL_HOURS=6
CRAWL_STALE_AFTER_MINUTES=120
